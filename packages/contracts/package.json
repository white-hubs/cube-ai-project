{
  "name": "@cube-ai/contracts",
  "version": "0.0.1-alpha.18",
  "description": "Single source of truth for Zod schemas (SDK + Mock + Engine + tests).",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./errors": {
      "import": "./src/errors/index.ts",
      "types": "./src/errors/index.ts"
    },
    "./ids": {
      "import": "./src/common/ids.ts",
      "types": "./src/common/ids.ts"
    },
    "./session": {
      "import": "./src/session/index.ts",
      "types": "./src/session/index.ts"
    },
    "./sse": {
      "import": "./src/sse/index.ts",
      "types": "./src/sse/index.ts"
    },
    "./versioning": {
      "import": "./src/versioning/index.ts",
      "types": "./src/versioning/index.ts"
    },
    "./platform": {
      "import": "./src/platform/index.ts",
      "types": "./src/platform/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./errors": {
        "import": "./dist/errors/index.js",
        "types": "./dist/errors/index.d.ts"
      },
      "./ids": {
        "import": "./dist/common/ids.js",
        "types": "./dist/common/ids.d.ts"
      },
      "./session": {
        "import": "./dist/session/index.js",
        "types": "./dist/session/index.d.ts"
      },
      "./sse": {
        "import": "./dist/sse/index.js",
        "types": "./dist/sse/index.d.ts"
      },
      "./versioning": {
        "import": "./dist/versioning/index.js",
        "types": "./dist/versioning/index.d.ts"
      },
      "./platform": {
        "import": "./dist/platform/index.js",
        "types": "./dist/platform/index.d.ts"
      }
    },
    "access": "public",
    "registry": "http://nexus.guhecloud.com:8888/repository/npm-hosted/"
  },
  "scripts": {
    "build": "bun run clean && bunx tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
