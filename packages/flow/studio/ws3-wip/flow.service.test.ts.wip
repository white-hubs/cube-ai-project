      deleted: '0',
    }

    let syncedGraph: SyncedGraphPayload | null = null

    const service = new FlowService(
      {
        findByIdScoped: mock(async () => currentFlow),
        existsNameForTenant: mock(async () => false),
        updateRow: mock(async (_id: string, patch: Record<string, unknown>) => {
          currentFlow = {
            ...currentFlow,
            ...patch,
          }
        }),
      } as never,
      {
        replaceForFlow: mock(async () => {}),
        listByFlowId: mock(async () => []),
      } as never,
      {} as never,
      {
        getCatalogMap: mock(async () => new Map([[knowledgeComponent.componentKey, knowledgeComponent]])),
      } as never,
      {} as never,
      {} as never,
      {
        findByBizDocumentId: mock(async () => ({
          id: '77',
          tenant: 1001,
          biz_document_id: 'biz-doc-1',
          biz_document_name: '知识文档 1',
          biz_directory_id: 'biz-dir-1',
          ai_center_document_id: 'doc-remote-1',
          ai_center_project_id: 'project-1',
          upload_status: 'uploaded',
          last_segmented_at: null,
          remark: null,
          create_by: 'system',
          creator_id: null,
          creator_type: null,
          create_time: new Date(),
          update_by: 'system',
          updater_id: null,
          updater_type: null,
          update_time: new Date(),
          deleted: '0',
        })),
      } as never,
      {
        createProjectClient: mock(async () => ({
          getConfig: () => ({ baseUrl: 'https://ai-center.example.com' }),
          createFlow: mock(async () => ({ id: 'remote-flow-1' })),
          updateFlow: mock(async (_flowId: string, request: Record<string, unknown>) => {
            syncedGraph = request.graph as SyncedGraphPayload
            return { id: 'remote-flow-1' }
          }),
        })),
      } as never,
      {
        getByTenant: mock(async () => ({
          id: '1',
          tenant: 1001,
          project_id: 'project-1',
          project_name: '租户项目',
          project_description: null,
          ai_center_api_key_id: null,
          ai_center_api_key: 'tenant-key-1',
          enabled: true,
          remark: null,
          create_by: 'system',
          creator_id: null,
          creator_type: null,
          create_time: new Date(),
          update_by: 'system',
          updater_id: null,
          updater_type: null,
          update_time: new Date(),
          deleted: '0',
        })),
      } as never,
    )

    const result = await service.saveFlow('9001', {
      editorFlowJson: {
        schemaVersion: 'ai-application-flow/v1',
        nodes: [
          {
            id: 'node-kr',
            componentKey: 'knowledge-retrieval',
            label: '知识检索',
            position: { x: 120, y: 80 },
            data: {
              config: {
                documentIds: ['biz-doc-1'],
                topK: 4,
              },
            },
          },
        ],
        edges: [],
        metadata: {},
      },
    })

    expect(result.remoteBindingStatus).toBe('linked')
    expect(result.remoteFlowId).toBe('remote-flow-1')
    expect(syncedGraph).toBeTruthy()
    const syncedGraphSnapshot = syncedGraph as unknown as SyncedGraphPayload
    const syncedNodes = syncedGraphSnapshot.nodes
    const firstSynced = syncedNodes[0]
    if (firstSynced === undefined) {
      throw new Error('expected at least one synced node')
    }
    expect(firstSynced.cubeType).toBe('cube.lf.CustomComponent')
    expect((firstSynced.config as Record<string, unknown>).knowledge_sources_runtime_json).toBe(
      JSON.stringify([{ document_id: 'doc-remote-1', top_k: 4, min_score: 0.4 }]),
    )
  })

  test('runFlowForEngine wraps runFlow result in engine envelope', async () => {
    const service = new FlowService(
      {} as never,
      {} as never,
      {} as never,
      {} as never,
      {} as never,
      {} as never,
      {} as never,
      {} as never,
      {} as never,
    )
    const runResult = { raw: { session_id: 'session-1' } }
    service.runFlow = mock(async () => runResult) as never

    const result = await service.runFlowForEngine('9001', { input: 'hello' })

    expect(service.runFlow).toHaveBeenCalledWith('9001', { input: 'hello' })
    expect(result.scheduled).toBe(true)
    expect(result.jobId).toMatch(/^\d+$/)
    expect(result.remoteFlowRunId).toBe('session-1')
    expect(result.estimatedDurationMs).toBe(0)
    expect(result.statusUrl).toBe(`/v1/jobs/${result.jobId}`)
  })

