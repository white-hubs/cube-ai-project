      enabled: true,
      remark: null,
      create_by: 'system',
      creator_id: null,
      creator_type: null,
      create_time: new Date(),
      update_by: 'system',
      updater_id: null,
      updater_type: null,
      update_time: new Date(),
      deleted: '0',
    }

    const service = new FlowService(
      {
        findByIdScoped: mock(async () => flow),
      } as never,
      {} as never,
      {} as never,
      {
        getCatalogMap: mock(async () => new Map([[chatInputComponent.componentKey, chatInputComponent]])),
      } as never,
      {} as never,
      {} as never,
      {} as never,
      {
        createProjectClient: mock(async () => ({
          runFlow: mock(async () => ({
            raw: {
              session_id: 'session-1',
              outputs: [
                {
                  outputs: [
                    {
                      results: {
                        message: {
                          data: {
                            type: 'text/markdown',
                            content: '# 总结\n\n- 已完成',
                          },
                        },
                      },
                    },
                  ],
                },
              ],
            },
          })),
        })),
      } as never,
      {
        getByTenant: mock(async () => ({
          id: '1',
          tenant: 1001,
          project_id: 'project-1',
          project_name: '租户项目',
          project_description: null,
          ai_center_api_key_id: null,
          ai_center_api_key: 'tenant-key-1',
          enabled: true,
          remark: null,
          create_by: 'system',
          creator_id: null,
          creator_type: null,
          create_time: new Date(),
          update_by: 'system',
          updater_id: null,
          updater_type: null,
          update_time: new Date(),
          deleted: '0',
        })),
      } as never,
    )

    const result = await service.debugFlow('debug-flow-1', { input: 'hello' })
    const keys = Object.keys(result)

    expect(result.ok).toBe(true)
    expect(result.mode).toBe('remote-run')
    expect(result.input).toBe('hello')
    expect(result.outputText).toBe('# 总结\n\n- 已完成')
    expect(result.outputCount).toBe(1)
    expect(keys).not.toContain('compiledGraph')
    expect(keys).not.toContain('trace')
    expect(keys).not.toContain('request')
    expect(keys).not.toContain('response')
    expect(keys).not.toContain('variables')
    expect(keys).not.toContain('startedAt')
    expect(keys).not.toContain('finishedAt')
  })
})

describe('FlowController', () => {
  test('runFlow keeps existing service response without engine caller header', async () => {
    const serviceResult = { raw: { session_id: 'session-ordinary' } }
    const runFlow = mock(async () => serviceResult)
    const runFlowForEngine = mock(async () => ({
      scheduled: true,
      jobId: '1',
      estimatedDurationMs: 0,
      statusUrl: '/v1/jobs/1',
    }))
    const controller = new FlowController({ runFlow, runFlowForEngine } as never)

    const result = await controller.runFlow('9001', { input: 'hello' }, { getHeader: () => null } as never)

    expect(result).toBe(serviceResult)
    expect(runFlow).toHaveBeenCalledWith('9001', { input: 'hello' })
    expect(runFlowForEngine).not.toHaveBeenCalled()
  })

  test('runFlow preserves structured multimodal input for service execution', async () => {
    const serviceResult = { raw: { session_id: 'session-files' } }
    const runFlow = mock(async () => serviceResult)
    const runFlowForEngine = mock(async () => ({
      scheduled: true,
      jobId: '1',
      estimatedDurationMs: 0,
      statusUrl: '/v1/jobs/1',
    }))
    const controller = new FlowController({ runFlow, runFlowForEngine } as never)
    const body = {
      input: {
        query: 'describe image',
        files: [{ file_path: 'flow-1/image.png', name: 'image.png', mime: 'image/png' }],
      },
      sessionId: 'session-files',
    }

    const result = await controller.runFlow('9001', body, { getHeader: () => null } as never)

    expect(result).toBe(serviceResult)
    expect(runFlow).toHaveBeenCalledWith('9001', body)
    expect(runFlowForEngine).not.toHaveBeenCalled()
  })

  test('uploadFlowFile reads multipart file and delegates to service', async () => {
    const uploaded = { file_path: 'flow-1/image.png', name: 'image.png', mime: 'image/png' }
    const uploadFlowFile = mock(async () => uploaded)
    const controller = new FlowController({ uploadFlowFile } as never)
    const form = new FormData()
    const file = new File([new Uint8Array([1, 2, 3])], 'image.png', { type: 'image/png' })
    form.set('file', file)

    const result = await controller.uploadFlowFile('9001', { getBody: async () => form } as never)

    expect(result).toBe(uploaded)
    expect(uploadFlowFile).toHaveBeenCalledWith('9001', file)
  })

  test('runFlow uses engine envelope path when engine caller header is present', async () => {
    const engineResult = {
      scheduled: true,
      jobId: '1',
      remoteFlowRunId: 'session-engine',
      estimatedDurationMs: 0,
      statusUrl: '/v1/jobs/1',
    }
    const runFlow = mock(async () => ({ raw: { session_id: 'ordinary' } }))
    const runFlowForEngine = mock(async () => engineResult)
    const headers = new Headers({ 'X-Engine-Caller': 'cube-agentic-engine' })
    const controller = new FlowController({ runFlow, runFlowForEngine } as never)

    const result = await controller.runFlow('9001', { input: 'hello' }, { getHeader: (key: string) => headers.get(key) } as never)

    expect(result).toBe(engineResult)
    expect(runFlowForEngine).toHaveBeenCalledWith('9001', { input: 'hello' })
    expect(runFlow).not.toHaveBeenCalled()
  })
})
