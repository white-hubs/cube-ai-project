{
  "name": "@cube-ai/flow-core",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Flow bounded context — Langflow sync, DSL v2, playground, execution (M4).",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./mock": {
      "import": "./src/mock/index.ts",
      "types": "./src/mock/index.ts"
    },
    "./platform": {
      "import": "./src/platform/index.ts",
      "types": "./src/platform/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 180000",
    "dev:single": "bun run src/single.ts",
    "sync-components": "bun run scripts/sync-components.ts --from-file data/langflow-api-all.json --out generated/cube-component-catalog.json"
  },
  "dependencies": {
    "@cube-ai/contracts": "workspace:*",
    "@cube-ai/llm-core": "workspace:*",
    "@dangao/bun-server": "catalog:bun-server",
    "@modelcontextprotocol/sdk": "catalog:",
    "@opentelemetry/api": "catalog:",
    "reflect-metadata": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
