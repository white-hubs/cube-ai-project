{
  "name": "@cube-ai/platform-adapter-ghcloud",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Platform Port adapters bridging agent-engine to ghcloud (Flow / Knowledge / LLM Catalog) plus JWT/session/gRPC.",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./tokens": {
      "import": "./src/tokens.ts",
      "types": "./src/tokens.ts"
    },
    "./flow": {
      "import": "./src/flow/flow.module.ts",
      "types": "./src/flow/flow.module.ts"
    },
    "./knowledge": {
      "import": "./src/knowledge/knowledge.module.ts",
      "types": "./src/knowledge/knowledge.module.ts"
    },
    "./catalog": {
      "import": "./src/catalog/catalog.module.ts",
      "types": "./src/catalog/catalog.module.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:rpc",
    "@connectrpc/connect": "catalog:rpc",
    "@connectrpc/connect-node": "catalog:rpc",
    "@cube-ai/contracts": "workspace:*",
    "@dangao/bun-server": "catalog:bun-server",
    "@dangao/nacos-client": "catalog:",
    "lru-cache": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
