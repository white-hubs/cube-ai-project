{
  "name": "@cube-ai/kb-sdk-console",
  "version": "0.0.0-m2-skeleton-c",
  "type": "module",
  "description": "Knowledge document management console — /kb/documents against ai-center.",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "http://nexus.guhecloud.com:8888/repository/npm-hosted/",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target=browser --format=esm --sourcemap=external && bunx tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
