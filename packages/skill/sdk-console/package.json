{
  "name": "@cube-ai/skill-sdk-console",
  "version": "0.0.1",
  "type": "module",
  "description": "Skill management console SDK for AI skill center.",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "http://nexus.guhecloud.com:8888/repository/npm-hosted/",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target=browser --format=esm --sourcemap=external --external @cube-ai/contracts && bunx tsc -p tsconfig.build.json && bun scripts/verify-dist-exports.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@cube-ai/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
