    "@opentelemetry/semantic-conventions": "catalog:otel",
    "@qdrant/js-client-rest": "catalog:vector",
    "@tachu/core": "catalog:tachu",
    "@tachu/extensions": "catalog:tachu",
    "@tachu/host-defaults": "catalog:tachu",
    "bullmq": "catalog:queue",
    "ioredis": "catalog:queue",
    "jose": "catalog:",
    "lru-cache": "catalog:",
    "mysql2": "catalog:",
    "openapi-fetch": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "prom-client": "catalog:",
    "reflect-metadata": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
