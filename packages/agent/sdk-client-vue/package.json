{
  "name": "@cube-ai/agent-sdk-client-vue",
  "version": "0.0.1-alpha.18",
  "description": "Vue 3 composables on top of @cube-ai/agent-sdk-client. Browser-only.",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "access": "public",
    "registry": "http://nexus.guhecloud.com:8888/repository/npm-hosted/"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target=browser --format=esm --sourcemap=external --external vue --external @cube-ai/agent-sdk-client --external @cube-ai/agent-sdk-client-assistant --external @cube-ai/contracts && bunx tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@cube-ai/agent-sdk-client": "workspace:*",
    "@cube-ai/agent-sdk-client-assistant": "workspace:*",
    "@cube-ai/contracts": "workspace:*"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:test",
    "typescript": "catalog:",
    "vue": "catalog:vue"
  },
  "peerDependencies": {
    "vue": "catalog:vue"
  }
}
