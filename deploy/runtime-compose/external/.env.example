# =============================================================================
# cube-ai-center — 外置依赖运行时模板（共享部署环境）
# =============================================================================
# 用法：cp .env.example .env，填 AI_CENTER_IMAGE 与外部 MySQL/Redis/Qdrant 地址。
# =============================================================================

DEPLOY_ENV=DEV
AI_CENTER_VERSION=dev-local
BUILD_SHA=local

# 发布镜像（build-image.sh --push 产物；勿用 latest 除非显式追加）
AI_CENTER_IMAGE=registry.kh.internal/cube-ai/cube-ai-center:REPLACE_WITH_SHA7

AI_CENTER_HOST_PORT=3000
AI_CENTER_CONTAINER_PORT=3000

# ── 外部 MySQL（必填）──────────────────────────────────────────────────────
MYSQL_HOST=mysql.example.internal
MYSQL_PORT=3306
MYSQL_USER=agentic_engine
MYSQL_PASSWORD=REPLACE_ME
MYSQL_DB=cube_ai_center

# ── 外部 Redis（必填）──────────────────────────────────────────────────────
REDIS_URL=redis://redis.example.internal:6379/0

# ── 外部 Qdrant（必填）─────────────────────────────────────────────────────
QDRANT_URL=http://qdrant.example.internal:6333

# ── 可选：Nacos（descriptor / secret 发现）──────────────────────────────────
# NACOS_ADDRESS=nacos.example.internal:8848
# NACOS_NAMESPACE=
# NACOS_USERNAME=
# NACOS_PASSWORD=

# ── 可选：外部 OTel Collector ───────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── 鉴权 ────────────────────────────────────────────────────────────────────
# 共享部署：启用 ghcloud 身份并填 JWT_KEY_URL（去掉 USE_GHCLOUD_IDENTITY=0）
# USE_GHCLOUD_IDENTITY=1
# JWT_KEY_URL=http://<oauth-host>/oauth2/jwt.key

# 本地冒烟（verify-ai-center-http.sh）默认 mock：
USE_GHCLOUD_IDENTITY=0
AGENTIC_ENGINE_AUTH_MODE=mock

# ── LLM catalog（与 engine/flow/kb 同库 MySQL）──────────────────────────────
AGENTIC_ENGINE_PROVIDER=agentic-platform-llm-catalog
# 仅 health 骨架、不做真实 Turn：
# AGENTIC_ENGINE_PROVIDER=noop
# 离线占位种子（不能真实出网）：
# CUBE_AI_CATALOG_DEV_SEED=1

LOG_LEVEL=INFO

# ── Descriptor / 全局 Prompt 挂载（相对 compose 目录或绝对路径）────────────
# DESCRIPTORS_DIR=../../../descriptors
# CONFIG_DIR=../../../config
# GLOBAL_PROMPT_FILE=../../../packages/agent/engine/CUBE.md
