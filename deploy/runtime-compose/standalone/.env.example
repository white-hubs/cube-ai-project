# =============================================================================
# cube-ai-center — 全内置运行时模板（共享部署环境）
# =============================================================================
# 用法：cp .env.example .env → docker compose up -d
# =============================================================================

DEPLOY_ENV=DEV
AI_CENTER_VERSION=dev-local
BUILD_SHA=local

AI_CENTER_IMAGE=registry.kh.internal/cube-ai/cube-ai-center:REPLACE_WITH_SHA7

AI_CENTER_HOST_PORT=3000
AI_CENTER_CONTAINER_PORT=3000

MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
QDRANT_HTTP_HOST_PORT=6333

MYSQL_PORT=3306
MYSQL_USER=agentic_engine
MYSQL_PASSWORD=agentic_engine_runtime
MYSQL_DB=cube_ai_center
MYSQL_ROOT_PASSWORD=root_runtime_only

# OTel：默认不导出；启用 collector 时：
#   docker compose --profile otel up -d
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318

# 鉴权：共享部署应配 JWT_KEY_URL；mock 仅用于本地冒烟
USE_GHCLOUD_IDENTITY=0
AGENTIC_ENGINE_AUTH_MODE=mock
# USE_GHCLOUD_IDENTITY=1
# JWT_KEY_URL=http://<oauth-host>/oauth2/jwt.key

AGENTIC_ENGINE_PROVIDER=agentic-platform-llm-catalog
# 空库首次启动可临时开占位种子（不能真实出网）：
# CUBE_AI_CATALOG_DEV_SEED=1

LOG_LEVEL=INFO

# DESCRIPTORS_DIR=../../../descriptors
# CONFIG_DIR=../../../config
# GLOBAL_PROMPT_FILE=../../../packages/agent/engine/CUBE.md
