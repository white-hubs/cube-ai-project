# =============================================================================
# cube-ai-project — Docker Compose 启动模板（dev / test）
# =============================================================================
# 用法：cp .env.example .env，按实际场景取消注释对应连接配置块。
# `bun run dev:*` 会在缺失时自动从本文件生成 .env。
# =============================================================================

# ─── 部署标识 ──────────────────────────────────────────────────────────────
DEPLOY_ENV=DEV
AI_CENTER_VERSION=dev-local
BUILD_SHA=local
BUILD_CREATED=2026-01-01T00:00:00Z

# 镜像（compose build 时生效；指向预构建 tag 时可覆盖）
AI_CENTER_IMAGE=cube-ai-project:ai-center-dev
AI_CENTER_PREBUILT_IMAGE=cube-ai-project:ai-center-prebuilt
# runtime-source | runtime-binary | runtime-binary-prebuilt（仅 ai-center profile）
AI_CENTER_BUILD_TARGET=runtime-source

# ─── 端口映射（host:container）──────────────────────────────────────────────
AI_CENTER_HOST_PORT=3000
AI_CENTER_PORT=3000
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
QDRANT_HTTP_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334

# =============================================================================
# 依赖服务连接（二选一）
# =============================================================================

# ── 场景 A（默认）：依赖在 host 上 ───────────────────────────────────────────
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=agentic_engine
MYSQL_USERNAME=agentic_engine
MYSQL_PASSWORD=agentic_engine_dev
MYSQL_DB=agentic_engine
MYSQL_DATABASE=agentic_engine
MYSQL_ROOT_PASSWORD=root_dev_only

REDIS_URL=redis://host.docker.internal:6379/0
QDRANT_URL=http://host.docker.internal:6333

# ── 场景 B：compose 起本地依赖（--profile deps / dev:up:prebuilt）──────────
# 取消注释下面整块，并注释掉场景 A 的 MYSQL_HOST / REDIS_URL / QDRANT_URL。
#
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_USER=agentic_engine
# MYSQL_PASSWORD=agentic_engine_dev
# MYSQL_DB=agentic_engine
# MYSQL_ROOT_PASSWORD=root_dev_only
#
# REDIS_URL=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333

# ─── ai-center 运行时（可选覆盖）────────────────────────────────────────────
LOG_LEVEL=DEBUG
AGENTIC_ENGINE_AUTH_MODE=mock

# ghcloud 身份中间件（WS3）：默认 **启用**（opt-out 语义）。
# 生产/预发须配 JWT_KEY_URL；不配则启动失败（fail-fast）。
# 本地开发无 JWT 服务时，设 USE_GHCLOUD_IDENTITY=0 回退 mock 身份。
# JWT_KEY_URL=http://<oauth-host>/oauth2/jwt.key
# USE_GHCLOUD_IDENTITY=0

# LLM provider：默认目录驱动（与 ghcloud agentic-platform-llm-catalog 对齐）。
# 设为 noop 可退回空实现（仅结构冒烟，chat/embed 不出网）。
AGENTIC_ENGINE_PROVIDER=agentic-platform-llm-catalog

# 真实 catalog 数据：catalog 与 engine/flow 同库（MySQL agentic_engine）。
# 用 ghcloud 导出迁入真实 provider/model/凭据（写入 llm_catalog_* 表）：
#   bun run catalog:migrate -- --source <ghcloud-export.json> --target mysql
#   （--mysql-url 缺省读 AGENTIC_ENGINE_MYSQL_URL）
# 有 MySQL 连接时 catalog 自动走 MySQL；无需额外开关。
# 离线无 MySQL 联调可用内置占位种子（密钥占位、不能真实出网）：
# CUBE_AI_CATALOG_DEV_SEED=1

# KB embedding 模型（须存在于 catalog；默认 doubao 多模态 embedding）。
# KB_EMBEDDING_MODEL=doubao-embedding-vision-251215

# Flow 执行后端（二选一）：
#   - 配 LANGFLOW_BASE_URL → 走 Langflow（生产对齐路径，支持完整图）。
#   - 或 EXP_USE_CUBE_FLOW_ENGINE=1 → 进程内 cube 线性引擎（仅 ChatInput→LLM 线性图，离线兜底）。
# LANGFLOW_BASE_URL=
# LANGFLOW_API_KEY=
# EXP_USE_CUBE_FLOW_ENGINE=1

# KB 外部依赖（生产能力需要；缺失时对应环节降级/报错，不影响其余闭环）：
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_KB_BUCKET=kb-documents
# DOCLING_BASE_URL=http://docling:5001

# ─── MCP servers（外部 MCP 工具：web-search / biz-ontology 等）───────────────
# 首次使用：cp config/mcp-servers.example.json config/mcp-servers.json，再按环境改 URL。
# 实际 config/mcp-servers.json 已 gitignore（仓库仅提交 .example 模板）。
# 注意尾斜杠：URL 原样使用、不自动规范化。不同 MCP 服务端要求相反
# （web-search 用 /mcp，biz-ontology 用 /mcp/）；写错会被 307 重定向导致握手失败。
# docker compose 已通过 /app/config/mcp-servers.json 注入（见 docker-compose.yaml 的 x-ai-center-env）。
# host 直跑（cd apps/ai-center && bun run dev）时进程 cwd 为 apps/ai-center，
# 需改用相对仓库根或绝对路径：
# AGENTIC_ENGINE_MCP_SERVERS_CONFIG=../../config/mcp-servers.json
# MCP server 连不上时的连接超时（ms，默认 10000）：
# AGENTIC_ENGINE_MCP_CONNECT_TIMEOUT_MS=10000
