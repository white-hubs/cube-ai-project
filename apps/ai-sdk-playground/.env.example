# Vite dev proxy default target (server-side only; copy to .env.local)
AI_CENTER_BASE_URL=https://ai-center-prebuilt.cube-ai-project.orb.local/
AI_PLAYGROUND_PORT=5173

# Browser SDK headers (VITE_ prefix)
VITE_AI_CENTER_TENANT=1000000000000000001
VITE_AI_CENTER_TERMINAL=ai-sdk-playground-dev
VITE_AI_CENTER_DEV_TOKEN=dev-token
