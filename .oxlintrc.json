{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // DI: keep typescript/consistent-type-imports off — emitDecoratorMetadata needs
  // value imports for @Injectable() constructor params (not `import type`).
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "warn",
    "perf": "warn",
    "style": "warn",
    "nursery": "off"
  },
  "rules": {
    "capitalized-comments": "off",
    "func-style": "off",
    "id-length": "off",
    "init-declarations": "off",
    "func-names": "off",
    "max-classes-per-file": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-params": "off",
    "max-statements": "off",
    "new-cap": "off",
    "no-await-in-loop": "off",
    "no-continue": "off",
    "no-inline-comments": "off",
    "no-loop-func": "off",
    "no-magic-numbers": "off",
    "no-negated-condition": "off",
    "no-nested-ternary": "off",
    "no-promise-executor-return": "off",
    "no-ternary": "off",
    "object-shorthand": "off",
    "prefer-const": "off",
    "prefer-destructuring": "off",
    "prefer-named-capture-group": "off",
    "prefer-template": "off",
    "require-await": "off",
    "sort-keys": "off",
    "typescript/method-signature-style": "off",
    // See top-of-file note: type-only imports erase ctor paramtypes for bun-server DI.
    "typescript/consistent-type-imports": "off",
    "typescript/no-empty-interface": "off",
    "typescript/no-extraneous-class": ["error", { "allowWithDecorator": true }],
    "typescript/parameter-properties": "off",
    "unicorn/catch-error-name": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/filename-case": "off",
    "unicorn/no-await-expression-member": "off",
    "unicorn/no-negated-condition": "off",
    "unicorn/no-nested-ternary": "off",
    "unicorn/no-null": "off",
    "unicorn/no-thenable": "off",
    "unicorn/no-useless-undefined": "off",
    "unicorn/number-literal-case": "off",
    "unicorn/numeric-separators-style": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/prefer-array-find": "off",
    "unicorn/prefer-export-from": "off",
    "unicorn/prefer-native-coercion-functions": "off",
    "unicorn/prefer-set-has": "off",
    "unicorn/prefer-single-call": "off",
    "unicorn/prefer-spread": "off",
    "unicorn/prefer-structured-clone": "off",
    "unicorn/prefer-string-replace-all": "off",
    "unicorn/prefer-ternary": "off",
    "no-underscore-dangle": ["error", { "allow": ["_l1Set"] }]
  },
  "ignorePatterns": ["**/dist/**", "**/lib/**", "**/node_modules/**", "**/.tmp/**", "**/coverage/**"]
}
