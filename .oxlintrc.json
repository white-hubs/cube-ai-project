{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "warn",
    "perf": "warn",
    "style": "warn",
    "nursery": "off"
  },
  "ignorePatterns": ["**/dist/**", "**/lib/**", "**/node_modules/**", "**/.tmp/**", "**/coverage/**"]
}
