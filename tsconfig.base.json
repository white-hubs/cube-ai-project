{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "types": ["bun-types"],
    "baseUrl": ".",
    "paths": {
      "@cube-ai/ai-center/platform/server-base": ["./apps/ai-center/src/platform/server-base/src/index.ts"],
      "@cube-ai/ai-center/platform/server-base/*": ["./apps/ai-center/src/platform/server-base/src/*"],
      "@cube-ai/ai-center/platform/server-shared": ["./apps/ai-center/src/platform/server-shared/src/index.ts"],
      "@cube-ai/ai-center/platform/server-shared/*": ["./apps/ai-center/src/platform/server-shared/src/*"],
      "@cube-ai/ai-center/platform/server-mock": ["./apps/ai-center/src/platform/server-mock/src/index.ts"],
      "@cube-ai/ai-center/platform/server-mock/*": ["./apps/ai-center/src/platform/server-mock/src/*"]
    }
  }
}
